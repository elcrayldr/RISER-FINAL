<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>RiserLab</title>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default"><line choice="com.crayldr.riserlab.pkg"/></line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.crayldr.riserlab.pkg" visible="false">
        <pkg-ref id="com.crayldr.riserlab.pkg"/>
    </choice>
    <pkg-ref id="com.crayldr.riserlab.pkg" version="@VERSION@" onConclusion="none">RiserLab-component.pkg</pkg-ref>
</installer-gui-script>
